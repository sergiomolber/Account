    {
      "name": "CP002 Validar Usuario inválido",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"El código de estado es 401\", function () {\r",
              "    pm.response.to.have.status(401);\r",
              "});\r",
              "\r",
              "pm.test(\"El mensaje es correcto\", function () {\r",
              "    const response = pm.response.json();\r",
              "    pm.expect(response.error_description).to.eql(\"Invalid client ID or secret, or client not subscribed to this API\");\r",
